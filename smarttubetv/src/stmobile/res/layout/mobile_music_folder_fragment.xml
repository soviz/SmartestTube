<?xml version="1.0" encoding="utf-8"?>
<!-- Music folder-details screen. Toolbar with back + folder title, then a 2-column
     grid of that folder's videos. No swipe-refresh/pagination: the group is a fixed,
     already-loaded list (see MobileMusicFolderFragment). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mobile_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/mobile_primary">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:gravity="center"
            android:text="←"
            android:textColor="@color/mobile_text_primary"
            android:textSize="24sp"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/folder_details_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/mobile_text_primary"
            android:textSize="18sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/folder_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />
</LinearLayout>
