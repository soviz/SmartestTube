<?xml version="1.0" encoding="utf-8"?>
<!-- One settings entry row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:background="?android:attr/selectableItemBackground">

    <ImageView
        android:id="@+id/settings_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginEnd="20dp"
        android:scaleType="fitCenter"
        android:tint="@color/mobile_text_primary" />

    <TextView
        android:id="@+id/settings_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/mobile_text_primary"
        android:textSize="16sp" />

    <!-- Shown only for SettingsItem.isSwitch rows (see SettingsItemAdapter); GONE otherwise. -->
    <Switch
        android:id="@+id/settings_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:clickable="false"
        android:focusable="false" />
</LinearLayout>
