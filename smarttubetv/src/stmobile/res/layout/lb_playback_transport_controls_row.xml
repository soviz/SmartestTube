<?xml version="1.0" encoding="utf-8"?>
<!--
    stmobile override of the player transport row (main: time/remaining info BELOW the seek bar,
    large TV text, generous bottom padding). Phone tweaks, YouTube-style:
      - the seek bar is the LAST element, hugging the bottom edge of the video;
      - current/total time shares a row with the fullscreen toggle (time start-aligned,
        fullscreen end-aligned) directly above the seek bar, at half the TV text size;
      - minimal bottom padding.
    Overflow (gear) + speed buttons are NOT here — this row's own root view is only as tall as
    its content and gets vertically placed by Leanback's row-fragment machinery, so a
    top-aligned view inside it doesn't land at the true top of the video. They live in
    fragment_playback.xml instead, fixed via ConstraintLayout to the actual top-end corner.
    All view ids must be kept — PlaybackTransportRowPresenter resolves them by id.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingBottom="2dp" >

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent" >
        <!-- Phone: title sits near the TOP of the video strip (YouTube-style), not stacked
             directly above the transport controls at the bottom. -->
        <LinearLayout
            android:id="@+id/controls_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:clipToPadding="false"
            android:paddingStart="?attr/browsePaddingStart"
            android:paddingEnd="?attr/browsePaddingEnd"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" >

            <ImageView
                android:id="@+id/image"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/lb_playback_transport_image_height"
                android:layout_gravity="top"
                android:adjustViewBounds="true"
                android:layout_marginEnd="@dimen/lb_playback_transport_image_margin_end"
                android:scaleType="fitStart" />

            <FrameLayout
                android:id="@+id/description_dock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:clipToPadding="false"
                android:gravity="top" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/thumbs_row_wrapper"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/lb_playback_transport_thumbs_bottom_margin" >
            <com.liskovsoft.smartyoutubetv2.tv.ui.mod.leanback.playerglue.seekpreview.ThumbsBar
                android:id="@+id/thumbs_row"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/thumbs_row_title"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Hello World!"
                style="?attr/playbackControlsTimeStyle" />
        </LinearLayout>

    </FrameLayout>

    <!-- Phone: no side padding on the row itself — the seek bar runs edge-to-edge; the
         controls/time rows carry their own small inset instead. -->
    <com.liskovsoft.smartyoutubetv2.tv.ui.mod.leanback.playerglue.tweaks.PlaybackTransportRowView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/transport_row"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false" >

        <!-- MOD: hide player controls on UP button -->
        <LinearLayout android:id="@+id/top_edge"
                      android:orientation="horizontal"
                      android:layout_width="match_parent"
                      android:focusable="true"
                      android:layout_height="1dp"/>

        <RelativeLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layoutDirection="ltr"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="24dp"
                        tools:ignore="RtlHardcoded" >

            <!-- Phone: Previous / Play / Next centered (YouTube-style), not pinned to the start
                 edge like the TV remote-focused layout, and lifted off the seek bar (the extra
                 top/bottom padding above) so it reads as sitting near the middle of the video
                 strip rather than hugging the bottom edge. See VideoPlayerGlue#setCompactControls
                 for the Previous-Play-Next action order that lands Play in the visual middle. -->
            <FrameLayout
                android:id="@+id/controls_dock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
            />

            <RelativeLayout android:id="@+id/additional_info"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone"
                            android:focusable="false" >
                <TextView
                    android:id="@+id/quality_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="?attr/playbackControlsTimeStyle" />
                <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.time.DateTimeView
                    android:id="@+id/date_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="?attr/playbackControlsTimeStyle" />
            </RelativeLayout>
        </RelativeLayout>

        <!-- Phone: secondary controls dock (unused in compact mode - see VideoPlayerGlue
             #setCompactControls, kept only for the non-compact/TV action set) below the transport
             row, above the seek bar. The fullscreen toggle (mobile_fullscreen_btn) lives in this
             same row, end-aligned, so it's one container instead of a separately positioned
             overlay that has to be nudged back into place whenever this row's layout changes.
             MobilePlaybackFragment still resolves it via activity.findViewById() - id/class
             unchanged, only its position in the tree moved. -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/lb_control_button_height"
            android:layoutDirection="ltr"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            tools:ignore="RtlHardcoded" >
            <FrameLayout
                android:id="@+id/secondary_controls_dock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true" >
            </FrameLayout>

            <!-- Phone: only current/total time shown, sharing this row with the fullscreen
                 toggle - start-aligned, vertically centered. ending_time/quality_info/date_time
                 are kept in the tree (PlaybackTransportRowPresenter resolves them by id and
                 writes to them unconditionally) but collapsed to zero size elsewhere - per
                 feedback, Remaining/quality/date-time clutter the video on a phone. -->
            <RelativeLayout android:id="@+id/time_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_alignParentStart="true"
                            android:layoutDirection="ltr"
                            android:focusable="false"
                            tools:ignore="RtlHardcoded" >
                <TextView
                    android:id="@+id/ending_time"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    style="?attr/playbackControlsTimeStyle" />

                <RelativeLayout android:id="@+id/current_time_wrapper"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layoutDirection="ltr"
                                android:focusable="false" >
                    <TextView
                        android:id="@+id/current_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@+id/separate_time"
                        android:textSize="11sp"
                        style="?attr/playbackControlsTimeStyle" />

                    <TextView
                        android:id="@+id/separate_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lb_playback_time_separator"
                        android:layout_toStartOf="@+id/total_time"
                        android:layout_marginStart="@dimen/lb_playback_transport_time_margin"
                        android:textSize="11sp"
                        style="?attr/playbackControlsTimeStyle" />

                    <TextView
                        android:id="@+id/total_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_marginStart="@dimen/lb_playback_transport_time_margin"
                        android:textSize="11sp"
                        style="?attr/playbackControlsTimeStyle" />
                </RelativeLayout>
            </RelativeLayout>

            <ImageButton
                android:id="@+id/mobile_fullscreen_btn"
                android:layout_width="@dimen/lb_fullscreen_button_size"
                android:layout_height="@dimen/lb_fullscreen_button_size"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:padding="@dimen/lb_fullscreen_button_padding"
                android:src="@drawable/ic_fullscreen_enter"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:visibility="visible"
                android:contentDescription="@string/mobile_fullscreen_toggle" />
        </RelativeLayout>

        <!-- Phone: seek bar last — hugs the bottom edge of the video, YouTube-style. -->
        <com.liskovsoft.smartyoutubetv2.tv.ui.mod.leanback.misc.SeekBar
            android:id="@+id/playback_progress"
            android:layout_width="match_parent"
            android:layout_height="@dimen/lb_playback_transport_progressbar_height"
            android:focusable="true"
            android:focusableInTouchMode="true" />

    </com.liskovsoft.smartyoutubetv2.tv.ui.mod.leanback.playerglue.tweaks.PlaybackTransportRowView>
</LinearLayout>
