<?xml version="1.0" encoding="utf-8"?>
<!-- Card root width and thumbnail (frame) height are set in code (VideoCardAdapter). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp"
    android:clickable="true"
    android:focusable="true"
    android:background="?android:attr/selectableItemBackground">

    <!-- Frame wraps the thumbnail so the duration badge can overlay its bottom-right,
         like YouTube. Height is set in code (width * 9 / 16). -->
    <FrameLayout
        android:id="@+id/card_thumb_frame"
        android:layout_width="match_parent"
        android:layout_height="1dp">

        <ImageView
            android:id="@+id/card_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@color/mobile_thumbnail_placeholder"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/card_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="4dp"
            android:background="@drawable/mobile_badge_bg"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/mobile_text_primary"
        android:textSize="13sp" />

    <!-- Channel name, then view count + publish date on the same line, e.g.
         "Channel  •  1.2M views • 3 days ago". Author is fixed-width (its own text, not
         stretched) so a long channel name doesn't push the meta text off-screen without
         ellipsizing it first; meta takes the rest of the line and ellipsizes itself. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/card_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="140dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="11sp" />

        <!-- View count + publish date, e.g. "1.2M views • 3 days ago". -->
        <TextView
            android:id="@+id/card_meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
